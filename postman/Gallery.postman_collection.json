              "mode": "raw",
              "raw": "{\"title\":\"Sunset\",\"url\":\"https://example.com/sunset.jpg\",\"description\":\"Evening\",\"accessLevel\":\"PRIVATE\",\"albumId\":{{albumId}},\"tagIds\":[{{tagId}}]}"
