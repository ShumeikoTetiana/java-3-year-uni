{
  "info": {
    "name": "Gallery API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8180"
    },
    {
      "key": "clientSecret",
      "value": "YOUR_CLIENT_SECRET"
    },
    {
      "key": "userName",
      "value": "alice"
    },
    {
      "key": "userPassword",
      "value": "alice"
    },
    {
      "key": "adminName",
      "value": "admin1"
    },
    {
      "key": "adminPassword",
      "value": "admin1"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "albumId",
      "value": ""
    },
    {
      "key": "photoId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Auth (Keycloak)",
      "item": [
        {
          "name": "Get USER token",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "gallery-app"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "username",
                  "value": "{{userName}}"
                },
                {
                  "key": "password",
                  "value": "{{userPassword}}"
                }
              ]
            },
            "url": "{{keycloakUrl}}/realms/gallery/protocol/openid-connect/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get ADMIN token",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "gallery-app"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "username",
                  "value": "{{adminName}}"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}"
                }
              ]
            },
            "url": "{{keycloakUrl}}/realms/gallery/protocol/openid-connect/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Tags",
      "item": [
        {
          "name": "Create tag",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tags",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"tag-{{$timestamp}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('tagId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List tags",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tags"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update tag",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tags/{{tagId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"renamed-{{$timestamp}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
